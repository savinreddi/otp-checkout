# Postgres connection string, e.g. from Supabase's "Connection string" tab.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Port the API listens on. Most hosts (Render, Fly, etc.) set this for you.
PORT=8080

# Origin allowed to call the API (your deployed frontend URL). Use * for local dev.
ALLOWED_ORIGIN=http://localhost:5173
